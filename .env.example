# General
APP_ENV=development
TZ=America/Mazatlan
PULL_POLICY=missing
CHROMAT_API_IMAGE=chromat-api:dev
CHROMAT_INFERENCE_IMAGE=chromat-inference:dev
CHROMAT_DB_IMAGE=mariadb:11.8.2
CHROMAT_NGINX_IMAGE=nginx:1.29.2-alpine
MODEL_HOST_PATH=./inference/models/deterministic-model.json
TLS_CERT_HOST_PATH=./certs/dev/server.crt
TLS_KEY_HOST_PATH=./certs/dev/server.key

# MariaDB
DB_HOST=db
DB_PORT=3306
DB_NAME=chromat
DB_USER=chromat_user
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# API
API_PORT=3000

# Inferencia
INFERENCE_URL=http://inference:8000

# Almacenamiento
RAW_DATA_DIR=/app/uploads
RAW_MIN_FREE_PERCENT=20
UPLOAD_MAX_BYTES=10485760
RAW_RETENTION_DAYS=90
DERIVED_RETENTION_DAYS=365
BACKUP_EXTERNAL_DIR=/mnt/chromat-backups
BACKUP_AGE_RECIPIENT_FILE=/etc/chromat/backup-age-recipient
BACKUP_AGE_IDENTITY_FILE=/etc/chromat/backup-age-identity
BACKUP_SECRET_FILES=/etc/chromat/secrets/telegram-bot-token
BACKUP_MAX_SECONDS=3600
BACKUP_MODE=full
BACKUP_STATE_DIR=/var/lib/chromat/backup-state
BACKUP_BASE_DIR=
WORKER_LEASE_SECONDS=30
WORKER_POLL_MS=1000
WORKER_PROCESSING_DELAY_MS=1000
INFERENCE_PORT=8000
INFERENCE_URL=http://inference:8000
INFERENCE_MODEL_VERSION=deterministic-1
INFERENCE_MODEL_SHA256=785e60645aad9f5dd512ca275ff4db78bea9797d6cff2979530fd6bb24db46f3
OFFICIAL_ALGORITHM=hsv
AGGREGATION_RULE_VERSION=1
AGGREGATION_CONFIDENCE_THRESHOLD=0.8
AGGREGATION_CONSECUTIVE_EVENTS=3
AGGREGATION_MAX_EVENT_AGE_MS=604800000
AGGREGATION_MIN_ALERT_INTERVAL_MS=0

# Alertas
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
TELEGRAM_BOT_TOKEN_HOST_FILE=./secrets/telegram_bot_token
PANEL_URL=https://chromat.lan/panel/
ALERT_POLL_MS=1000
ALERT_LEASE_SECONDS=30